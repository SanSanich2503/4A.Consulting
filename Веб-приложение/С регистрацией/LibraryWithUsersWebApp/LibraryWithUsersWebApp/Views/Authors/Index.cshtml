@model AuthorViewModelList

@{
    ViewData["Title"] = "Авторы";
}

<div center>
    <h1>Авторы</h1>

    @if (Model.Items.Any())
    {
        <form method="get" align="center">
            <div class="form-group" style="display:inline-block;">
                <label>ФИО:</label>
                <input style="width:200px;" name="name" value="@Model.FilterViewModel.Title" class="form-control" />
                <input type="submit" value="Найти" class="btn btn-success" />
            </div>
        </form>
    }

    <br /> <a asp-controller="Authors" asp-action="Create" class="btn btn-success">Создать запись</a>
</div>

<br />
<table center>
    @if (Model.Items.Any())
    {
        <tr>
            <th>ФИО</th>
            <th style="width:500px;">Описание</th>
            <th></th>
        </tr>
    }
    @{
        foreach (var author in Model.Items)
        {
            <tr>
                <td>@author.Title</td>
                <td style="width:500px;text-align:justify;">@author.Description</td>
                <td>
                    <a asp-controller="Authors" asp-action="Update" asp-route-id="@author.Id" class="btn btn-outline-dark">Редактировать</a>
                    <br /><br /><a class="btn btn-danger deleteButton" data-id="@author.Id">Удалить</a>
                </td>
            </tr>
        }
    }
</table>

<br />
<div class="buttons" center>
    @if (Model.PageViewModel.HasPreviousPage)
    {
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageViewModel.PageNumber - 1)"
           class="btn  btn-outline-dark">
            Назад
        </a>
    }
    @if (Model.PageViewModel.HasNextPage)
    {
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageViewModel.PageNumber + 1)"
           class="btn btn-outline-dark">
            Вперед
        </a>
    }
</div>

<style>
    th {
        background-color: deepskyblue;
    }

    td {
        background-color: aliceblue;
    }

    th, td {
        width: 400px;
        border: 3px solid black;
        text-align: center;
    }

    .form-control {
        display: inline;
    }

    .form-group {
        text-align: center;
    }
</style>

@section Scripts {
    <script src="~/js/authors.js"></script>
}