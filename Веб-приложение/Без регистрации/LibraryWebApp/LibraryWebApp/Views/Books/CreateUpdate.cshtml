@model BookForm

@{
    ViewData["Title"] = $"{ViewBag.ActionName} записи";
}

<form asp-controller="Books" asp-action="@ViewBag.MethodName" method="post">
    <div class="validation" asp-validation-summary="ModelOnly"></div>
    <div class="form-group">
        <input type="hidden" asp-for="Id" value="@Model.Id" />
    </div>
    <div class="form-group">
        <label asp-for="Title">Название:</label>
        <input type="text" asp-for="Title" value="@Model.Title" />
        <span class="validation" asp-validation-for="Title"></span>
    </div>
    <br /><div class="form-group">
        <label asp-for="Description">Описание:</label>
        <br /><textarea asp-for="Description">@Model.Description</textarea>
        <span class="validation" asp-validation-for="Description"></span>
    </div>
    <br /><div class="form-group">
        <label asp-for="AuthorId">Автор:</label>
        <select asp-for="AuthorId" asp-items="Model.Authors" class="form-control"> </select>
        <span asp-validation-for="AuthorId" class="text-danger"></span>
    </div>
    <br /><div class="form-group">
        <label asp-for="Year">Год издания:</label>
        <input type="number" asp-for="Year" value="@Model.Year" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>
    <br /><div class="form-group">
        <label asp-for="Content">Оглавление:</label>
        <br /><textarea asp-for="Content">@Model.Content</textarea>
        <span class="validation" asp-validation-for="Content"></span>
    </div>
    <br /><div class="form-group">
        <label asp-for="Price">Цена:</label>
        <input type="number" asp-for="Price" value="@Model.Price" step="0.01"/>
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <br /><input type="submit" class="btn btn-danger" value="Сохранить" />
</form>

<style>
    textarea {
        width: 450px;
        height: 200px;
        text-align: justify;
    }

    label {
        width: 250px;
    }
</style>